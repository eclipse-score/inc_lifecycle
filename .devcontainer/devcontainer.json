{
    /// This devcontainer adds some specific customizations to the S-CORE base devcontainer
    /// Such as:
    /// - CA Certificates

    "name": "eclipse-s-core",
    "build": {
        "dockerfile": "Dockerfile",
        // runArgs (--network host) only applies to `docker run`. Build RUN steps
        // (e.g. feature apt-get installs) run in an isolated build network where a
        // loopback proxy at 127.0.0.1 is unreachable. Build on the host network and
        // forward the proxy as build args so those steps can reach the internet.
        "options": ["--network=${localEnv:DEVCONTAINER_NETWORK:bridge}"],
            "args": {
            "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
            "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
            "http_proxy": "${localEnv:http_proxy}",
            "https_proxy": "${localEnv:https_proxy}",
            "NO_PROXY": "${localEnv:NO_PROXY}",
            "no_proxy": "${localEnv:no_proxy}"
        }
    },

    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },

    // customize VS Code settings and extensions
    "customizations": {
        "vscode": {
        "extensions": [
            "anthropic.claude-code"
        ]
        }
    },

    "containerEnv": {
            // Forward the host proxy into the *running* container. build.args only
            // cover `docker build`; without these the running container (apt, git,
            // curl, bazel, ...) has no proxy and falls back to direct DNS, which the
            // corporate network blocks. Works at runtime because runArgs uses
            // --network host, so proxy on the Windows host is reachable.
            "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
            "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
            "http_proxy": "${localEnv:http_proxy}",
            "https_proxy": "${localEnv:https_proxy}",
            "ALL_PROXY": "${localEnv:ALL_PROXY}",
            "all_proxy": "${localEnv:all_proxy}",
            "NO_PROXY": "${localEnv:NO_PROXY}",
            "no_proxy": "${localEnv:no_proxy}"
    },

    "initializeCommand": { 
        "Initialize bazel cache on host": "mkdir -p ${localEnv:HOME}/.cache/bazel",
        "Make sure QNX licenses exists": "touch -a ~/.qnx/license/licenses",
        "Make sure .netrc exists": "touch -a ~/.netrc",
        // The env-file is used to pass custom environment variables into the container. 
        // Use format `KEY=VALUE` per line. The file is created if it doesn't exist.
        "Make sure env-file exists": "touch -a ~/.config/score-lifecycle-devcontainer.env"},

    // Mount ca-certificates from host
    "mounts": [
        {
            "source": "/usr/local/share/ca-certificates/",
            "target": "/usr/local/share/ca-certificates/",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.qnx/license",
            "target": "/opt/score_qnx/license",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.netrc",
            "target": "/home/vscode/.netrc",
            "type": "bind"
        }
    ],

    // Add your personal customizations
    "onCreateCommand": {
        // Object-form lifecycle commands run in PARALLEL, so the apt proxy config is
        // written inline (not as a separate entry) to guarantee it exists before apt runs.
        // sudo resets the environment (env_reset), dropping http_proxy/https_proxy, so
        // `sudo apt` would otherwise ignore the proxy vars from containerEnv. The apt.conf
        // drop-in survives sudo and persists for later apt use.
        "update certificates & install dependencies": "if [ -n \"$http_proxy\" ]; then printf 'Acquire::http::Proxy \"%s\";\\nAcquire::https::Proxy \"%s\";\\n' \"$http_proxy\" \"${https_proxy:-$http_proxy}\" | sudo tee /etc/apt/apt.conf.d/00proxy > /dev/null; fi && sudo apt update && sudo apt install -y --no-install-recommends ca-certificates-java openjdk-17-jre-headless libacl1-dev tmux fakechroot libvirt-daemon-system libvirt-clients bridge-utils virt-manager qemu-system-x86 qemu-system-arm && sudo update-ca-certificates",
        "bazel use system trust store": "echo 'startup --host_jvm_args=-Djavax.net.ssl.trustStore=/etc/ssl/certs/java/cacerts --host_jvm_args=-Djavax.net.ssl.trustStorePassword=changeit' | sudo tee --append /etc/bazel.bazelrc"
    },

    "runArgs": ["--device=/dev/kvm", "--network=${localEnv:DEVCONTAINER_NETWORK:bridge}", "--cap-add=SYS_NICE",  "--env-file", "${localEnv:HOME}/.config/score-lifecycle-devcontainer.env"],
    "postCreateCommand": "sudo chmod 666 /dev/kvm && sudo usermod -aG kvm $USER"
}
